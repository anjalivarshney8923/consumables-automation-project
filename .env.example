# ===================================================================
# IOCL Consumables / Procurement Management System
# Environment Variables Template (.env.example)
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit real credentials, passwords, or secrets to Git!
# ===================================================================

# Server Port
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/your_database_name
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# JWT Authentication Configuration
# Must be a 256-bit (32+ bytes) Base64 or Hex encoded secret key
JWT_SECRET=replace_with_a_long_secure_256_bit_random_secret_key_here
# Expiration time in milliseconds (e.g., 86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# Initial Admin Seeding Configuration (Created on startup if not already present)
ADMIN_NAME=IOCL Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_initial_admin_secure_password

# CORS Allowed Origins (Comma-separated for React Frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
